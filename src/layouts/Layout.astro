---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  themeColor?: string;
  image?: string;
  lang?: string;
  noindex?: boolean;
  languageAlternates?: Partial<Record<"de" | "en" | "fr" | "x-default", string>>;
}

const { 
  title = "Dorothea Urbantat | Geigenbaumeisterin", 
  description = "Geigenbau-Meisterin Dorothea Urbantat - Van der Woerd. Neubau, Reparatur, Setup & Kurse in Wegscheid und Markneukirchen.",
  themeColor = "#4a6b8a",
  image = "/assets/images/01-about.webp",
  lang = "de",
  noindex = false,
  languageAlternates,
} = Astro.props;

const siteURL = new URL(Astro.site || "https://geigenbau-meisterin.de");
const canonicalURL = new URL(Astro.url.pathname, siteURL);
const imageURL = new URL(image, siteURL);

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": "https://geigenbau-meisterin.de/#dorothea-urbantat",
      "name": "Dorothea Urbantat",
      "alternateName": "Dorothea Van der Woerd",
      "jobTitle": "Geigenbaumeisterin",
      "url": "https://geigenbau-meisterin.de/",
      "sameAs": ["https://www.instagram.com/geigenbau_meisterin/"]
    },
    {
      "@type": "Organization",
      "@id": "https://geigenbau-meisterin.de/#organization",
      "name": "Dorothea Urbantat Geigenbau",
      "url": "https://geigenbau-meisterin.de/",
      "logo": imageURL.toString(),
      "founder": { "@id": "https://geigenbau-meisterin.de/#dorothea-urbantat" },
      "sameAs": ["https://www.instagram.com/geigenbau_meisterin/"]
    },
    {
      "@type": "LocalBusiness",
      "@id": "https://geigenbau-meisterin.de/#wegscheid",
      "name": "Dorothea Urbantat Geigenbau – Wegscheid",
      "image": imageURL.toString(),
      "description": description,
      "url": "https://geigenbau-meisterin.de/",
      "telephone": "+4915735230786",
      "email": "info@geigenbau-meisterin.de",
      "parentOrganization": { "@id": "https://geigenbau-meisterin.de/#organization" },
      "address": { "@type": "PostalAddress", "streetAddress": "Thalberg-Steindlbach 3", "postalCode": "94110", "addressLocality": "Wegscheid", "addressCountry": "DE" },
      "priceRange": "€€€"
    },
    {
      "@type": "LocalBusiness",
      "@id": "https://geigenbau-meisterin.de/#markneukirchen",
      "name": "Dorothea Urbantat Geigenbau – Markneukirchen",
      "image": imageURL.toString(),
      "description": description,
      "url": "https://geigenbau-meisterin.de/",
      "telephone": "+4915735230786",
      "email": "info@geigenbau-meisterin.de",
      "parentOrganization": { "@id": "https://geigenbau-meisterin.de/#organization" },
      "address": { "@type": "PostalAddress", "streetAddress": "Gunzener Straße 5", "postalCode": "08258", "addressLocality": "Markneukirchen-Breitenfeld", "addressCountry": "DE" },
      "priceRange": "€€€"
    }
  ]
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <meta name="theme-color" content={themeColor} />
    <meta name="generator" content={Astro.generator} />
    
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="canonical" href={canonicalURL} />
    {languageAlternates && Object.entries(languageAlternates).map(([hrefLang, href]) => (
      <link rel="alternate" hreflang={hrefLang} href={new URL(href, siteURL)} />
    ))}
    
    <title>{title}</title>

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:locale" content={lang === "de" ? "de_DE" : lang === "fr" ? "fr_FR" : "en_GB"} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={imageURL} />

    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <script>
      import { init } from "@plausible-analytics/tracker";

      init({
        domain: window.location.hostname,
        endpoint: "https://plausible.bruol.me/api/event",
      });
    </script>
  </head>
  <body class="min-h-screen bg-white text-ink selection:bg-brand selection:text-white">
    <slot />
  </body>
</html>
